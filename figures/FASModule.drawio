                <mxCell id="73" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 18px; font-weight: 400;&quot;&gt;Possible Update 3&lt;/span&gt;&lt;/h1&gt;&lt;h1 class=&quot;title-lg&quot; style=&quot;box-sizing: border-box; margin: 10px 0px 0px; padding: 0px; border: 0px; font-variant-ligatures: no-common-ligatures; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-stretch: inherit; line-height: 50px; font-family: &amp;quot;Playfair Display&amp;quot;, serif; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: initial; letter-spacing: 0.39px; color: rgb(15, 56, 80); background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• &lt;/font&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Add additional equations which also account for accumulation&lt;/font&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;perimeterSpacing=0;strokeColor=default;align=center;dashed=1;spacing=3;verticalAlign=middle;horizontal=1;" parent="1" vertex="1">
